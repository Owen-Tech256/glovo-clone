# Copy to .env for local development. Never commit .env.
# Values below are placeholders, not working credentials.

# development | testing | production. If unset, the app starts as production (fails safe).
APP_ENV=development

# Required in production (at least 32 characters, not a placeholder). Development has a built-in dev-only value.
SECRET_KEY=change-me-use-a-long-random-value

# PostgreSQL only. Development and production require this.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/marketplace_dev

# Required by the testing config. The database name must end in _test and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/marketplace_test

# Rate-limit storage. memory:// is fine for one local process, not for production (see docs/DECISIONS_NEEDED.md P-02).
RATELIMIT_STORAGE_URI=memory://

# Logging level and the placeholder site name shown in the layout (brand not decided, see P-09).
LOG_LEVEL=INFO
SITE_NAME=Marketplace
